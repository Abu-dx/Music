{
  "name": "stem-monitor-desktop",
  "version": "0.1.0",
  "description": "Multi-track stem separation, monitoring and chord analysis desktop application",
  "main": "dist/main/app/main/index.js",
  "scripts": {
    "build": "tsc",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode development",
    "build:all": "npm run build:main && npm run build:renderer",
    "start": "npm run build:all && electron dist/main/app/main/index.js",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "webpack --config webpack.renderer.config.js --mode development --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "electron": ">=28.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "electron": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "eslint": "^8.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.5.0",
    "html-webpack-plugin": "^5.6.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "zustand": "^4.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
